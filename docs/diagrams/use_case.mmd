    B --> UC1
    B --> UC2
    B --> UC3

    L --> UC4
    L --> UC5
    L --> UC6

    I --> UC7
    I --> UC8
    I --> UC9

    R --> UC10
    R --> UC11

    UC1 -.->|includes| UC2
    UC4 -.->|includes| UC5
    UC4 -.->|includes| UC6

    style UC11 stroke:#ff5722,stroke-width:2px
