        UC5[Verify ZK Proof]
        UC6[Select Threshold Band]
        UC7[Ingest Transaction Data]
        UC8[Anchor Commitment]
        UC9[Record Loan Event]
        UC10[Query Ledger History]
        UC11["Read-Only Access (Write Blocked)"]
